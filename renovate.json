{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "customManagers:helmChartYamlAppVersions",
    ":enablePreCommit"
  ],
  "assignees": ["MVProwess"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^charts/linkstack/values\\.yaml$/"],
      "matchStrings": [
        "image:\\s+registry:\\s+docker\\.io\\s+repository:\\s+(?<depName>[^\\s]+)\\s+tag:\\s+(?<currentValue>[^\\s]+)\\s+digest:\\s+(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Track LinkStack through its separate digest field instead of the tag-only Helm values extractor",
      "matchManagers": ["helm-values"],
      "matchFileNames": ["charts/linkstack/values.yaml"],
      "matchPackageNames": ["docker.io/linkstackorg/linkstack"],
      "enabled": false
    }
  ]
}
